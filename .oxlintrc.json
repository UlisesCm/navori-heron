{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "rules": { "typescript/no-explicit-any": "error" },
  "ignorePatterns": [
    "coverage/**",
    "fixtures/**",
    "schemas/**",
    ".claude/**",
    ".codex/**",
    ".navori/**"
  ]
}
