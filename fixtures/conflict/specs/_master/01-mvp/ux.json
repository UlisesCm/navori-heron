{
  "schemaVersion": 1,
  "masterStage": "01-mvp",
  "surfaces": [
    {
      "id": "MOBILE",
      "name": "Member app",
      "actors": [
        "ACT-MEMBER"
      ],
      "purpose": "Members browse and redeem benefits.",
      "capabilities": [
        "Browse benefits",
        "Redeem a benefit"
      ],
      "constraints": [
        "Only active members see benefits"
      ],
      "requirements": [
        "RN-1",
        "RF-1",
        "RF-2"
      ]
    },
    {
      "id": "DASHBOARD",
      "name": "Admin dashboard",
      "actors": [
        "ACT-ADMIN"
      ],
      "purpose": "Admins manage members and partners.",
      "capabilities": [
        "Manage members",
        "Manage partners"
      ],
      "constraints": [],
      "requirements": [
        "RF-4"
      ]
    },
    {
      "id": "PARTNER",
      "name": "Partner portal",
      "actors": [
        "ACT-PARTNER"
      ],
      "purpose": "Partners publish benefits and validate redemptions.",
      "capabilities": [
        "Publish benefits",
        "Validate redemptions"
      ],
      "constraints": [
        "Partners never see member data"
      ],
      "requirements": [
        "RN-2",
        "RF-3"
      ]
    }
  ],
  "actors": [
    {
      "id": "ACT-MEMBER",
      "name": "Member",
      "goal": "Use partner benefits.",
      "capabilities": [
        "Browse benefits",
        "Redeem a benefit"
      ],
      "constraints": [
        "Needs an active membership"
      ],
      "surfaces": [
        "MOBILE"
      ],
      "forbiddenActions": [
        "See other members' data"
      ],
      "relations": [
        "Redeems benefits offered by ACT-PARTNER"
      ]
    },
    {
      "id": "ACT-PARTNER",
      "name": "Partner",
      "goal": "Attract members with benefits.",
      "capabilities": [
        "Publish benefits",
        "Validate redemptions",
        "See member data"
      ],
      "constraints": [],
      "surfaces": [
        "PARTNER"
      ],
      "forbiddenActions": [
        "See member data"
      ],
      "relations": [
        "Validates redemptions made by ACT-MEMBER"
      ]
    },
    {
      "id": "ACT-ADMIN",
      "name": "Admin",
      "goal": "Run the membership program.",
      "capabilities": [
        "Manage members",
        "Manage partners"
      ],
      "constraints": [],
      "surfaces": [
        "DASHBOARD"
      ],
      "forbiddenActions": [
        "Edit a partner's benefits"
      ],
      "relations": []
    }
  ],
