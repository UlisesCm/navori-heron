{
  "$schema": "https://ulisescm.github.io/navori-harness/schema/navori.config.v1.json",
  "name": "navori-heron",
  "version": "1.0.0",
  "engines": [
    "claude",
    "codex"
  ],
  "preset": "custom",
  "language": "es",
  "branchBase": "develop",
  "gitignoreHarness": "off",
  "prTarget": "develop",
  "commits": "conventional-es",
  "audit": {
    "mode": "opt-in"
  },
  "harness": {
    "orchestrator": true,
    "implementer": true,
    "reviewer": true,
    "scout": true,
    "auditor": true,
    "publisher": true,
    "scribe": true,
    "scribeOwnsMarkdown": false,
    "planTiers": false,
    "masterPlan": true
  },
  "models": {
    "orchestrator": "opus",
    "implementer": "sonnet",
    "reviewer": "sonnet",
    "scout": "sonnet",
    "auditor": "sonnet",
    "publisher": "haiku",
    "scribe": "haiku",
    "architect": "opus"
  },
  "effort": {
    "orchestrator": "xhigh",
    "implementer": "medium",
    "reviewer": "medium",
    "scout": "medium",
    "auditor": "medium",
    "publisher": "low",
    "scribe": "low",
    "architect": "xhigh"
  },
  "plugins": {
    "engram": {
      "enabled": true
    },
    "gh": {
      "enabled": true
    },
    "codegraph": {
      "enabled": true
    },
    "tgrep": {
      "enabled": true
    }
  },
  "project": {
    "legacyPaths": [],
    "criticalAreas": [
      "src/core/store",
      "src/core/state",
      "src/core/contracts",
      "src/security",
      "src/intake/adapters/navori-master",
      "src/agents/adapters",
      "src/penpot",
      "src/web/auth",
      "tests/repo/boundaries.test.ts"
    ],
    "criticalPaths": [
      "src/core/store/**",
      "src/core/state/**",
      "src/core/contracts/**",
      "src/security/**",
      "src/agents/adapters/**",
      "src/penpot/**",
      "src/web/auth/**",
      "schemas/**",
      ".github/workflows/**",
      "infra/**"
    ],
    "posture": "greenfield",
    "reviewRigor": "pragmatic",
    "architectureRule": "bin → cli|web → app (run* → UseCaseResult) → dominio puro (core/state, tokens, design, validation, export, penpot/compiler) y puertos→adapters (intake, research, agents, penpot); contratos Zod versionados en core/contracts; solo core/store toca el filesystem; fronteras en tests/repo/boundaries.test.ts",
    "testsForNewCode": "when-applicable",
    "testsExclude": [],
    "localSkills": [
      "heron-architecture",
      "heron-design-tokens",
      "heron-accessibility"
    ],
    "libraries": [],
    "libraryMigrations": [],
    "codeLanguage": "ts"
  }
}
